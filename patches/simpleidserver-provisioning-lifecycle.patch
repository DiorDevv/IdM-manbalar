diff --git a/src/IdServer/SimpleIdServer.IdServer/Provisioning/UserDeprovisioningService.cs b/src/IdServer/SimpleIdServer.IdServer/Provisioning/UserDeprovisioningService.cs
new file mode 100644
index 0000000..79a347d
--- /dev/null
+++ b/src/IdServer/SimpleIdServer.IdServer/Provisioning/UserDeprovisioningService.cs
@@ -0,0 +1,157 @@
+// Copyright (c) SimpleIdServer. All rights reserved.
+// Licensed under the Apache License, Version 2.0. See LICENSE in the project root for license information.
+using Microsoft.Extensions.Logging;
+using SimpleIdServer.IdServer.Domains;
+using SimpleIdServer.IdServer.Helpers;
+using SimpleIdServer.IdServer.Stores;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace SimpleIdServer.IdServer.Provisioning;
+
+public interface IUserDeprovisioningService
+{
+    Task<DeprovisioningResult> Execute(IdentityProvisioning instance, string realm, CancellationToken cancellationToken);
+}
+
+public class DeprovisioningResult
+{
+    public int NbBlocked { get; set; }
+    public int NbUnblocked { get; set; }
+    public bool IsSkipped { get; set; }
+    public string SkipReason { get; set; }
+}
+
+/// <summary>
+/// Blocks the users imported by an identity provisioning instance when they are removed or disabled in the source,
+/// and unblocks them when they are enabled again. Only blocks set by this service are lifted:
+/// a block set by an administrator or by too many login attempts is never touched.
+/// </summary>
+public class UserDeprovisioningService : IUserDeprovisioningService
+{
+    /// <summary>
+    /// UnblockDateTime used to recognize a block set by deprovisioning.
+    /// </summary>
+    public static readonly DateTime DeprovisionedUntil = new DateTime(9999, 12, 31, 0, 0, 0, DateTimeKind.Utc);
+    /// <summary>
+    /// Suffix added to the login of a user removed from the source. Like Active Directory, which frees the sAMAccountName of
+    /// a deleted account, the login can then be used by a new account (rehire: new objectGUID, same login).
+    /// </summary>
+    public const string RemovedLoginSuffix = "~removed~";
+    private const int SearchPageSize = 500;
+    private readonly IEnumerable<IIdentityStateProvider> _stateProviders;
+    private readonly IUserRepository _userRepository;
+    private readonly IUserSessionResitory _userSessionRepository;
+    private readonly ILogger<UserDeprovisioningService> _logger;
+
+    public UserDeprovisioningService(IEnumerable<IIdentityStateProvider> stateProviders, IUserRepository userRepository, IUserSessionResitory userSessionRepository, ILogger<UserDeprovisioningService> logger)
+    {
+        _userSessionRepository = userSessionRepository;
+        _stateProviders = stateProviders;
+        _userRepository = userRepository;
+        _logger = logger;
+    }
+
+    public static bool IsDeprovisioned(User user) => user.Status == UserStatus.BLOCKED && user.UnblockDateTime == DeprovisionedUntil;
+
+    public async Task<DeprovisioningResult> Execute(IdentityProvisioning instance, string realm, CancellationToken cancellationToken)
+    {
+        var stateProvider = _stateProviders.SingleOrDefault(p => p.Name == instance.Definition.Name);
+        if (stateProvider == null) return Skip(instance, $"the provisioning source '{instance.Definition.Name}' cannot list its identities");
+        var states = await stateProvider.GetUserStates(instance.Definition, cancellationToken);
+        if (!states.ExistingUserIds.Any()) return Skip(instance, "the source returned no users");
+
+        var provisionedUsers = await GetProvisionedUsers(instance.Id, realm, cancellationToken);
+        var toBlock = provisionedUsers
+            .Where(u => !states.ExistingUserIds.Contains(u.Id) || states.DisabledUserIds.Contains(u.Id))
+            .Where(u => !IsDeprovisioned(u))
+            .ToList();
+        var toUnblock = provisionedUsers
+            .Where(u => states.ExistingUserIds.Contains(u.Id) && !states.DisabledUserIds.Contains(u.Id))
+            .Where(IsDeprovisioned)
+            .ToList();
+        // Blocked earlier (before the login was freed on removal): free their login too.
+        var toRename = provisionedUsers
+            .Where(u => !states.ExistingUserIds.Contains(u.Id) && IsDeprovisioned(u) && !u.Name.Contains(RemovedLoginSuffix))
+            .ToList();
+        if (provisionedUsers.Any() && toBlock.Count * 100 > provisionedUsers.Count * states.MaxBlockPercentage)
+            return Skip(instance, $"{toBlock.Count} of {provisionedUsers.Count} users would be blocked, more than the limit of {states.MaxBlockPercentage}%");
+
+        var ids = toBlock.Concat(toUnblock).Concat(toRename).Select(u => u.Id).ToList();
+        if (!ids.Any()) return new DeprovisioningResult();
+        var trackedUsers = (await _userRepository.GetUsersById(ids, cancellationToken)).ToDictionary(u => u.Id);
+        foreach (var user in toBlock)
+        {
+            var trackedUser = trackedUsers[user.Id];
+            trackedUser.Status = UserStatus.BLOCKED;
+            trackedUser.UnblockDateTime = DeprovisionedUntil;
+            trackedUser.UpdateDateTime = DateTime.UtcNow;
+            _userRepository.Update(trackedUser);
+            // Close the open SSO sessions as well: UserSessionJob (every 10 seconds) notifies the clients (back-channel logout).
+            var sessions = await _userSessionRepository.GetActive(user.Id, realm, cancellationToken);
+            foreach (var session in sessions)
+            {
+                session.State = UserSessionStates.Rejected;
+                _userSessionRepository.Update(session);
+            }
+
+            var reason = states.ExistingUserIds.Contains(user.Id) ? "disabled" : "removed";
+            if (reason == "removed" && !trackedUser.Name.Contains(RemovedLoginSuffix))
+                trackedUser.Name = $"{trackedUser.Name}{RemovedLoginSuffix}{DateTime.UtcNow:yyyyMMddHHmmss}";
+            _logger.LogWarning("Deprovisioning: user '{UserId}' ({Login}) is {Reason} in '{Source}', blocked, {NbSessions} session(s) revoked", user.Id, trackedUser.Name, reason, instance.Definition.Name, sessions.Count());
+        }
+
+        foreach (var user in toUnblock)
+        {
+            var trackedUser = trackedUsers[user.Id];
+            trackedUser.ResetLoginAttempt();
+            // Restored in the source (e.g. AD recycle bin): give the login back; the next import refreshes it from the source anyway.
+            var suffixIndex = trackedUser.Name.IndexOf(RemovedLoginSuffix, StringComparison.Ordinal);
+            if (suffixIndex > 0) trackedUser.Name = trackedUser.Name.Substring(0, suffixIndex);
+            trackedUser.UpdateDateTime = DateTime.UtcNow;
+            _userRepository.Update(trackedUser);
+            _logger.LogWarning("Deprovisioning: user '{UserId}' ({Login}) is enabled again in '{Source}', unblocked", user.Id, user.Name, instance.Definition.Name);
+        }
+
+        foreach (var user in toRename)
+        {
+            var trackedUser = trackedUsers[user.Id];
+            trackedUser.Name = $"{trackedUser.Name}{RemovedLoginSuffix}{DateTime.UtcNow:yyyyMMddHHmmss}";
+            trackedUser.UpdateDateTime = DateTime.UtcNow;
+            _userRepository.Update(trackedUser);
+            _logger.LogWarning("Deprovisioning: login of the removed user '{UserId}' freed, renamed to '{Login}'", user.Id, trackedUser.Name);
+        }
+
+        return new DeprovisioningResult { NbBlocked = toBlock.Count, NbUnblocked = toUnblock.Count };
+    }
+
+    private async Task<List<User>> GetProvisionedUsers(string instanceId, string realm, CancellationToken cancellationToken)
+    {
+        var result = new List<User>();
+        var skip = 0;
+        while (true)
+        {
+            var page = await _userRepository.Search(realm, new SearchRequest
+            {
+                Filter = $"IdentityProvisioningId == \"{instanceId}\"",
+                OrderBy = "Id",
+                Skip = skip,
+                Take = SearchPageSize
+            }, cancellationToken);
+            result.AddRange(page.Content);
+            skip += SearchPageSize;
+            if (skip >= page.Count) break;
+        }
+
+        return result;
+    }
+
+    private DeprovisioningResult Skip(IdentityProvisioning instance, string reason)
+    {
+        _logger.LogError("Deprovisioning of '{Instance}' skipped: {Reason}", instance.Definition.Name, reason);
+        return new DeprovisioningResult { IsSkipped = true, SkipReason = reason };
+    }
+}
