@@ -0,0 +1,99 @@
+// Copyright (c) SimpleIdServer. All rights reserved.
+// Licensed under the Apache License, Version 2.0. See LICENSE in the project root for license information.
+using Hangfire;
+using MassTransit;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging;
+using SimpleIdServer.IdServer.Helpers;
+using SimpleIdServer.IdServer.Provisioning;
+using SimpleIdServer.IdServer.Stores;
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace SimpleIdServer.IdServer.Jobs;
+
+/// <summary>
+/// Scheduled synchronization: for every enabled identity provisioning instance of every realm, extract the users
+/// from the source and import them automatically (the import then runs the deprovisioning).
+/// </summary>
+[AutomaticRetry(Attempts = 0)]
+public class IdentityProvisioningSyncJob : BaseJob
+{
+    /// <summary>
+    /// When the latest process is younger than this and not imported yet, it is considered running: no new process is launched.
+    /// An older unfinished process is considered failed.
+    /// </summary>
+    private static readonly TimeSpan RunningProcessTimeout = TimeSpan.FromMinutes(30);
+    private readonly IConfiguration _configuration;
+    private readonly IRealmRepository _realmRepository;
+    private readonly IIdentityProvisioningStore _identityProvisioningStore;
+    private readonly ITransactionBuilder _transactionBuilder;
+    private readonly IBusControl _busControl;
+    private readonly ILogger<IdentityProvisioningSyncJob> _logger;
+
+    public IdentityProvisioningSyncJob(
+        IRealmRepository realmRepository,
+        IIdentityProvisioningStore identityProvisioningStore,
+        ITransactionBuilder transactionBuilder,
+        IBusControl busControl,
+        IRecurringJobStatusRepository recurringJobStatusRepository,
+        IConfiguration configuration,
+        ILogger<IdentityProvisioningSyncJob> logger) : base(recurringJobStatusRepository)
+    {
+        _configuration = configuration;
+        _realmRepository = realmRepository;
+        _identityProvisioningStore = identityProvisioningStore;
+        _transactionBuilder = transactionBuilder;
+        _busControl = busControl;
+        _logger = logger;
+    }
+
+    protected override async Task ExecuteInternal()
+    {
+        // Comma separated names of the provisioning definitions to synchronize (e.g. "LDAP"). Empty: all enabled instances.
+        var names = (_configuration["IdentityProvisioningSync:Definitions"] ?? string.Empty)
+            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
+        var realms = await _realmRepository.GetAll(CancellationToken.None);
+        foreach (var realm in realms)
+        {
+            var instances = await _identityProvisioningStore.Search(realm.Name, new SearchRequest { Skip = 0, Take = int.MaxValue }, CancellationToken.None);
+            foreach (var instance in instances.Content.Where(i => i.IsEnabled))
+            {
+                var instanceWithDefinition = await _identityProvisioningStore.Get(realm.Name, instance.Id, CancellationToken.None);
+                if (names.Any() && !names.Contains(instanceWithDefinition.Definition.Name, StringComparer.OrdinalIgnoreCase)) continue;
+                await Launch(realm.Name, instance.Id);
+            }
+        }
+    }
+
+    private async Task Launch(string realm, string instanceId)
+    {
+        string processId;
+        using (var transaction = _transactionBuilder.Build())
+        {
+            var instance = await _identityProvisioningStore.Get(realm, instanceId, CancellationToken.None);
+            var latest = instance.Processes.OrderByDescending(p => p.CreateDateTime).FirstOrDefault();
+            if (latest != null && latest.EndImportDateTime == null && latest.CreateDateTime > DateTime.UtcNow - RunningProcessTimeout)
+            {
+                _logger.LogInformation("Synchronization of '{Instance}' skipped: the process '{ProcessId}' is still running", instance.Definition.Name, latest.Id);
+                return;
+            }
+
+            processId = instance.Launch();
+            _identityProvisioningStore.Update(instance);
+            await transaction.Commit(CancellationToken.None);
+            _logger.LogInformation("Synchronization of '{Instance}' launched, process '{ProcessId}'", instance.Definition.Name, processId);
+        }
+
+        var sendEndpoint = await _busControl.GetSendEndpoint(new Uri($"queue:{ExtractUsersConsumer.Queuename}"));
+        await sendEndpoint.Send(new StartExtractUsersCommand
+        {
+            InstanceId = instanceId,
+            Realm = realm,
+            ProcessId = processId,
+            AutoImport = true
+        });
+    }
+}
