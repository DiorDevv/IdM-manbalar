+// Copyright (c) SimpleIdServer. All rights reserved.
+// Licensed under the Apache License, Version 2.0. See LICENSE in the project root for license information.
+using SimpleIdServer.IdServer.Domains;
+using System.Collections.Generic;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace SimpleIdServer.IdServer.Provisioning;
+
+/// <summary>
+/// Implemented by provisioning sources that can list the current state of every identity (not only the changed ones),
+/// so that identities removed or disabled in the source can be blocked in the identity server (deprovisioning).
+/// </summary>
+public interface IIdentityStateProvider
+{
+    string Name { get; }
+    Task<IdentityStates> GetUserStates(IdentityProvisioningDefinition definition, CancellationToken cancellationToken);
+}
+
+public class IdentityStates
+{
+    /// <summary>
+    /// Identifiers of all users present in the source, enabled or not.
+    /// </summary>
+    public HashSet<string> ExistingUserIds { get; set; } = new HashSet<string>();
+    /// <summary>
+    /// Identifiers of the users present but disabled in the source.
+    /// </summary>
+    public HashSet<string> DisabledUserIds { get; set; } = new HashSet<string>();
+    /// <summary>
+    /// Safety limit: when more than this percentage of the provisioned users would be blocked in one run,
+    /// nothing is blocked (the source is probably misconfigured or partially unavailable).
+    /// </summary>
+    public int MaxBlockPercentage { get; set; } = 20;
+}
