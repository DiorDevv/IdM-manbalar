         Counters.AuthSuccess(client?.Id, realm);
-        return Redirect(returnUrl);
+        return RedirectToReturnUrl(realm, returnUrl);
+    }
+
+    /// <summary>
+    /// A ReturnUrl protected with a data-protection key that no longer exists (e.g. the server restarted and its keys
+    /// were kept in memory) cannot be unprotected, and redirecting to the raw value ends in a 404 such as /master/pwd/CfDJ8...
+    /// Only redirect to local or absolute URLs; otherwise fall back to the realm home page.
+    /// </summary>
+    protected IActionResult RedirectToReturnUrl(string realm, string returnUrl)
+    {
+        if (!string.IsNullOrWhiteSpace(returnUrl) && (Url.IsLocalUrl(returnUrl) || Uri.IsWellFormedUriString(returnUrl, UriKind.Absolute)))
+            return Redirect(returnUrl);
+
+        return Redirect(Url.Content(string.IsNullOrWhiteSpace(realm) ? "~/" : $"~/{realm}"));
     }
 
