+        /// <summary>
+        /// The cached access token becomes invalid when the identity server restarts (its signing keys can change).
+        /// Drop it, fetch a new one for the same realm and return it, so the failed request can be retried once.
+        /// </summary>
+        private async Task<string> RefreshAccessToken(string rejectedAccessToken)
+        {
+            var realm = _accessTokenStore.AccessTokens.FirstOrDefault(kvp => kvp.Value.AccessToken == rejectedAccessToken).Key;
+            if (realm == null) return null;
+            _accessTokenStore.AccessTokens.TryRemove(realm, out GetAccessTokenResult _);
+            _logger.LogWarning("Access token for realm '{Realm}' was rejected, requesting a new one", realm);
+            var languages = _httpClient.DefaultRequestHeaders.TryGetValues("Language", out var values) ? values.ToList() : new List<string>();
+            var token = await GetAccessToken(realm);
+            _httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token.AccessToken);
+            if (languages.Any()) _httpClient.DefaultRequestHeaders.Add("Language", languages);
+            return token.AccessToken;
