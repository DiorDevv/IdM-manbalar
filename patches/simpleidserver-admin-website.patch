+
+    internal class RefreshTokenOnUnauthorizedHandler : DelegatingHandler
+    {
+        private readonly Func<string, Task<string>> _refreshAccessToken;
+
+        public RefreshTokenOnUnauthorizedHandler(Func<string, Task<string>> refreshAccessToken)
+        {
+            _refreshAccessToken = refreshAccessToken;
+        }
+
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            var response = await base.SendAsync(request, cancellationToken);
+            var authorization = request.Headers.Authorization;
+            if (response.StatusCode != System.Net.HttpStatusCode.Unauthorized || authorization?.Scheme != "Bearer") return response;
+            var newAccessToken = await _refreshAccessToken(authorization.Parameter);
+            if (string.IsNullOrWhiteSpace(newAccessToken)) return response;
+            var retry = new HttpRequestMessage(request.Method, request.RequestUri)
+            {
+                Content = request.Content,
+                Version = request.Version
+            };
+            foreach (var header in request.Headers) retry.Headers.TryAddWithoutValidation(header.Key, header.Value);
+            retry.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", newAccessToken);
+            response.Dispose();
+            return await base.SendAsync(retry, cancellationToken);
+        }
